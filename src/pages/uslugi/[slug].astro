---
import { services, type LayoutVariant } from "../../data/services";
import StandardServiceLayout from "../../layouts/StandardServiceLayout.astro";
import stronySklepywwwLayout from "../../layouts/stronysklepywwwLayout.astro";
import BerberisLayout from "../../layouts/BerberisLayout.astro";
import obslugaItLayout from "../../layouts/obslugaitLayout.astro";
import ProgramyLayout from "../../layouts/ProgramyLayout.astro";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (() => {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}) satisfies GetStaticPaths;

const { service } = Astro.props;

// Określamy typ słownika: kluczem jest LayoutVariant, a wartością komponent Astro
const layoutMap: Partial<Record<LayoutVariant, any>> = {
  standard: StandardServiceLayout,
  stronysklepywww: stronySklepywwwLayout,
  Berberis: BerberisLayout,
  obslugait: obslugaItLayout,
  programy: ProgramyLayout,
  // Z czasem będziesz tu dopisywać kolejne layouty:
  // "web-creation": WebCreationServiceLayout,
};

// Pobieramy layout lub opadamy na StandardServiceLayout
const SelectedLayout =
  service.layoutVariant && layoutMap[service.layoutVariant]
    ? layoutMap[service.layoutVariant]
    : StandardServiceLayout;
---

<SelectedLayout service={service} />
