---
// Base visual card primitive — border / shadow / radius.
// Extended by ServiceCard and other section-specific cards.
export interface Props {
  class?: string;
  as?: "div" | "article" | "li";
  hoverable?: boolean;
  "data-od-id"?: string;
}

const { class: className = "", as: Tag = "div", hoverable = false, ...rest } = Astro.props;
---

<Tag
  class:list={[
    "card-surface p-6 md:p-8 shadow-sm",
    hoverable && "transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 hover:border-(--color-primary)",
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
