---
// src/components/ui/CookieBanner.astro
---

<!-- MODAL USTAWIEŃ -->
<div
  id="cookie-settings-modal"
  style="display: none;"
  class="fixed inset-0 z-[99999] flex items-center justify-center bg-black/60 p-3 backdrop-blur-sm w-screen h-screen overflow-hidden box-border"
>
  <div
    class="w-full max-w-md max-h-[85vh] overflow-y-auto rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg, #ffffff)] dark:bg-[var(--color-card-surface, #18181b)] p-4 sm:p-6 shadow-2xl box-border"
  >
    <h3
      class="mb-3 text-base sm:text-lg font-bold text-[var(--color-text-primary)]"
    >
      Ustawienia plików cookies
    </h3>

    <div class="mb-5 divide-y divide-[var(--color-border)] text-xs sm:text-sm">
      <div class="flex items-center justify-between py-2.5 gap-3">
        <div class="pr-2">
          <p class="font-medium text-[var(--color-text-primary)]">
            Niezbędne (Wymagane)
          </p>
          <p class="text-[11px] text-[var(--color-text-secondary)]">
            Kluczowe dla działania strony.
          </p>
        </div>
        <input
          type="checkbox"
          checked
          disabled
          class="h-5 w-5 rounded accent-[#00A2E0] opacity-60 flex-shrink-0"
        />
      </div>

      <div class="flex items-center justify-between py-2.5 gap-3">
        <div class="pr-2">
          <p class="font-medium text-[var(--color-text-primary)]">
            Analityka (Google Analytics)
          </p>
          <p class="text-[11px] text-[var(--color-text-secondary)]">
            Pomaga nam mierzyć wydajność serwisu.
          </p>
        </div>
        <input
          type="checkbox"
          id="toggle-analytics"
          class="h-5 w-5 rounded accent-[#00A2E0] cursor-pointer flex-shrink-0"
        />
      </div>

      <div class="flex items-center justify-between py-2.5 gap-3">
        <div class="pr-2">
          <p class="font-medium text-[var(--color-text-primary)]">
            Marketing i Reklamy
          </p>
          <p class="text-[11px] text-[var(--color-text-secondary)]">
            Dostosowywanie treści reklamowych.
          </p>
        </div>
        <input
          type="checkbox"
          id="toggle-ads"
          class="h-5 w-5 rounded accent-[#00A2E0] cursor-pointer flex-shrink-0"
        />
      </div>
    </div>

    <div class="flex justify-end gap-2">
      <button
        type="button"
        id="cookie-save-settings"
        class="w-full rounded-xl bg-[#00A2E0] px-5 py-2.5 text-xs sm:text-sm font-medium text-white cursor-pointer"
      >
        Zapisz wybrane
      </button>
    </div>
  </div>
</div>

<!-- GŁÓWNY BANER -->
<div
  id="cookie-banner"
  style="display: none; position: fixed !important; bottom: 0 !important; left: 0 !important; right: 0 !important; z-index: 99998 !important;"
  class="w-screen max-w-full p-3 box-border"
>
  <div
    class="mx-auto max-w-xl w-[calc(100vw-24px)] rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg, #ffffff)] dark:bg-[var(--color-card-surface, #18181b)] p-4 shadow-2xl backdrop-blur-md box-border"
  >
    <div class="flex flex-col gap-3">
      <div
        class="space-y-1 text-xs sm:text-sm text-[var(--color-text-secondary, #4b5563)]"
      >
        <p class="font-semibold text-[var(--color-text-primary, #111827)]">
          Szanujemy Twoją prywatność
        </p>
        <p>
          Używamy plików cookies w celu analizy ruchu i optymalizacji działania
          serwisu.
        </p>
      </div>
      <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-2 pt-1">
        <button
          type="button"
          id="cookie-settings-btn"
          class="col-span-1 inline-flex items-center justify-center rounded-xl border border-[var(--color-border)] bg-transparent px-3 py-2 text-xs font-medium text-[var(--color-text-primary)] cursor-pointer"
        >
          Ustawienia
        </button>
        <button
          type="button"
          id="cookie-reject-all"
          class="col-span-1 inline-flex items-center justify-center rounded-xl border border-[var(--color-border)] bg-transparent px-3 py-2 text-xs font-medium text-[var(--color-text-primary)] cursor-pointer"
        >
          Tylko niezbędne
        </button>
        <button
          type="button"
          id="cookie-accept-all"
          class="col-span-2 sm:col-auto sm:flex-1 inline-flex items-center justify-center rounded-xl bg-[#00A2E0] px-4 py-2 text-xs font-medium text-white cursor-pointer"
        >
          Akceptuję wszystkie
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var banner = document.getElementById("cookie-banner");
    var consent = localStorage.getItem("way_cookie_consent");

    if (!consent && banner) {
      banner.style.display = "block";
    }

    document.addEventListener("click", function (e) {
      var target = e.target;
      if (!target) return;

      var currentBanner = document.getElementById("cookie-banner");
      var modal = document.getElementById("cookie-settings-modal");

      if (target.closest("#cookie-settings-btn")) {
        if (modal) {
          modal.style.display = "flex";
          document.documentElement.style.overflow = "hidden";
        }
        return;
      }

      if (target.closest("#cookie-accept-all")) {
        localStorage.setItem("way_cookie_consent", "all_granted");
        updateConsent("granted", "granted");
        closeEverything(currentBanner, modal);
        return;
      }

      if (target.closest("#cookie-reject-all")) {
        localStorage.setItem("way_cookie_consent", "all_denied");
        updateConsent("denied", "denied");
        closeEverything(currentBanner, modal);
        return;
      }

      if (target.closest("#cookie-save-settings")) {
        var chkAnalytics = document.getElementById("toggle-analytics");
        var chkAds = document.getElementById("toggle-ads");

        var consents = {
          analytics:
            chkAnalytics && chkAnalytics.checked ? "granted" : "denied",
          ads: chkAds && chkAds.checked ? "granted" : "denied",
        };

        localStorage.setItem("way_cookie_consent", "custom");
        localStorage.setItem("way_cookie_prefs", JSON.stringify(consents));

        updateConsent(consents.analytics, consents.ads);
        closeEverything(currentBanner, modal);
        return;
      }
    });

    function updateConsent(analyticsStatus, adsStatus) {
      if (typeof window.gtag === "function") {
        window.gtag("consent", "update", {
          analytics_storage: analyticsStatus,
          ad_storage: adsStatus,
          ad_user_data: adsStatus,
          ad_personalization: adsStatus,
        });
      }
    }

    function closeEverything(bannerEl, modalEl) {
      if (bannerEl) bannerEl.style.display = "none";
      if (modalEl) modalEl.style.display = "none";
      document.documentElement.style.overflow = "";
    }
  })();
</script>
