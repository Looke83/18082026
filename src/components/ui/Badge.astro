---
export type BadgeVariant = "primary" | "accent" | "neutral";

export interface Props {
  variant?: BadgeVariant;
  class?: string;
}

const { variant = "primary", class: className = "" } = Astro.props;

const variants: Record<BadgeVariant, string> = {
  primary: "bg-(--color-primary-light) text-(--color-primary)",
  accent: "bg-(--color-accent-light) text-(--color-accent)",
  neutral: "bg-(--color-surface-alt) text-(--color-text-secondary)",
};
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold tracking-wide",
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
