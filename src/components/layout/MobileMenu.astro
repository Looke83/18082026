---
import { primaryNav, megaMenuColumns, headerCta } from "../../data/navigation";
import { categoryIcons } from "../../data/services";
import Icon from "../ui/Icon.astro";
import Button from "../ui/Button.astro";
---

<button
  id="mobile-menu-trigger"
  type="button"
  class="flex h-11 w-11 items-center justify-center rounded-lg text-(--color-text-primary) hover:bg-(--color-surface-alt) lg:hidden"
  aria-expanded="false"
  aria-controls="mobile-menu-panel"
  aria-label="Otwórz menu"
  data-od-id="mobile-menu-trigger"
>
  <Icon name="menu" class="h-6 w-6" />
</button>

<div
  id="mobile-menu-panel"
  data-mobile-panel
  data-open="false"
  inert
  class="fixed top-0 right-0 z-[100] flex h-[100dvh] w-[85vw] max-w-sm flex-col bg-(--color-background) shadow-2xl transition-transform duration-300 ease-in-out data-[open=false]:translate-x-full data-[open=true]:translate-x-0 lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menu główne"
  data-od-id="mobile-menu-panel"
>
  <div
    class="flex shrink-0 items-center justify-between border-b border-(--color-border) px-5 py-4"
  >
    <span class="font-heading text-lg font-bold text-(--color-text-primary)"
      >Menu</span
    >
    <button
      id="mobile-menu-close"
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-lg text-(--color-text-primary) hover:bg-(--color-surface-alt)"
      aria-label="Zamknij menu"
    >
      <Icon name="close" class="h-6 w-6" />
    </button>
  </div>

  <nav
    class="flex-1 min-h-0 overflow-y-auto px-5 py-6"
    aria-label="Nawigacja mobilna"
  >
    <ul class="space-y-1">
      <li>
        <a
          href="/"
          class="flex min-h-[44px] items-center rounded-lg px-2 text-base font-semibold text-(--color-text-primary) hover:bg-(--color-surface-alt)"
        >
          Home
        </a>
      </li>
      <li>
        <details class="group">
          <summary
            class="flex min-h-[44px] cursor-pointer list-none items-center justify-between rounded-lg px-2 text-base font-semibold text-(--color-text-primary) hover:bg-(--color-surface-alt)"
          >
            <span>Oferta</span>
            <Icon
              name="chevron-down"
              class="h-5 w-5 text-(--color-text-muted) transition-transform group-open:rotate-180"
            />
          </summary>
          <div class="mt-1 space-y-4 pb-3 pl-2">
            {
              megaMenuColumns.map((col) => (
                <div>
                  <details class="group/sub" open>
                    <summary class="flex cursor-pointer list-none items-center gap-2 py-2 text-xs font-bold uppercase tracking-wider text-(--color-text-muted)">
                      <Icon
                        name={categoryIcons[col.category]}
                        class="h-4 w-4 text-(--color-primary)"
                      />
                      <span>{col.title}</span>
                    </summary>
                    <ul class="space-y-1 border-l border-(--color-border) pl-4">
                      {col.links.map((link) => (
                        <li>
                          <a
                            href={link.href}
                            class="flex min-h-[44px] items-center text-sm text-(--color-text-secondary) hover:text-(--color-primary)"
                          >
                            {link.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                </div>
              ))
            }
          </div>
        </details>
      </li>
      {
        primaryNav.slice(2).map((link) => (
          <li>
            <a
              href={link.href}
              class="flex min-h-[44px] items-center rounded-lg px-2 text-base font-semibold text-(--color-text-primary) hover:bg-(--color-surface-alt)"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="shrink-0 border-t border-(--color-border) px-5 py-5">
    <Button href={headerCta?.href || "/"} variant="primary" class="w-full">
      {headerCta?.label || "Bezpłatna wycena"}
    </Button>
  </div>
</div>

<div
  id="mobile-menu-overlay"
  data-open="false"
  class="fixed inset-0 z-[90] bg-(--color-text-primary)/40 backdrop-blur-sm transition-opacity duration-300 data-[open=false]:pointer-events-none data-[open=false]:opacity-0 data-[open=true]:opacity-100 lg:hidden"
  aria-hidden="true"
>
</div>

<style>
  :global(body.menu-open) {
    overflow: hidden !important;
    overscroll-behavior: none;
  }

  :global(html.menu-open) {
    overflow: hidden !important;
  }
</style>

<script>
  const trigger = document.getElementById("mobile-menu-trigger");
  const closeBtn = document.getElementById("mobile-menu-close");
  const panel = document.getElementById("mobile-menu-panel");
  const overlay = document.getElementById("mobile-menu-overlay");
  const body = document.body;
  const html = document.documentElement;

  let lastFocused: HTMLElement | null = null;

  function getFocusable(container: HTMLElement): HTMLElement[] {
    return Array.from(
      container.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), summary, input, textarea, select, [tabindex]:not([tabindex="-1"])',
      ),
    );
  }

  function openMenu() {
    if (!panel || !overlay || !trigger) return;

    lastFocused = document.activeElement as HTMLElement;
    panel.dataset.open = "true";
    overlay.dataset.open = "true";

    // Zdejmujemy inert, żeby panel był dostępny dla czytników i klawiatury
    panel.removeAttribute("inert");

    body.classList.add("menu-open");
    html.classList.add("menu-open");

    trigger.setAttribute("aria-expanded", "true");

    setTimeout(() => {
      const focusables = getFocusable(panel);
      focusables[0]?.focus();
    }, 50);
  }

  function closeMenu() {
    if (!panel || !overlay || !trigger) return;

    panel.dataset.open = "false";
    overlay.dataset.open = "false";

    // Ukrywamy panel przed czytnikami i fokusem, gdy jest zamknięty
    panel.setAttribute("inert", "");

    body.classList.remove("menu-open");
    html.classList.remove("menu-open");

    trigger.setAttribute("aria-expanded", "false");
    lastFocused?.focus();
  }

  trigger?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  overlay?.addEventListener("click", closeMenu);

  document.addEventListener("keydown", (e) => {
    if (panel?.dataset.open !== "true") return;

    if (e.key === "Escape") {
      closeMenu();
    }

    if (e.key === "Tab") {
      const focusables = getFocusable(panel);
      if (focusables.length === 0) return;

      const first = focusables[0];
      const last = focusables[focusables.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
