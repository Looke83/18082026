---
// The only place max-w-[1440px] is defined. All sections wrap their
// content in this component to keep the layout consistent.
export interface Props {
  class?: string;
  as?: "div" | "section" | "nav";
}

const { class: className = "", as: Tag = "div" } = Astro.props;
---

<Tag class:list={["mx-auto w-full max-w-[1440px] px-4 md:px-8 lg:px-12", className]}>
  <slot />
</Tag>
