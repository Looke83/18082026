---
// Two-column contact block: form (posts to /api/contact) + company
// details and an embedded map. Client-side validation via a small
// island script; no framework dependency.
import Container from "../layout/Container.astro";
import Icon from "../ui/Icon.astro";
import Button from "../ui/Button.astro";
import { services } from "../../data/services";
import { footerColumns } from "../../data/navigation";
---

<section class="py-16 md:py-24 lg:py-32" data-od-id="contact-form-section" aria-labelledby="contact-heading">
  <Container class="grid gap-12 lg:grid-cols-[1fr_0.85fr] lg:gap-16">
    <div>
      <p class="eyebrow mb-4">Kontakt</p>
      <h2 id="contact-heading" class="text-3xl font-bold tracking-tight text-(--color-text-primary) md:text-4xl">
        Napisz do nas — odpowiadamy w ciągu jednego dnia roboczego
      </h2>

      <form
        id="contact-form"
        class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2"
        method="post"
        action="/api/contact"
        novalidate
        data-od-id="contact-form"
      >
        <div class="flex flex-col gap-2">
          <label for="cf-name" class="text-sm font-medium text-(--color-text-primary)">Imię i nazwisko *</label>
          <input
            id="cf-name" name="name" type="text" required autocomplete="name"
            class="min-h-[44px] rounded-lg border border-(--color-border) bg-(--color-background) px-4 py-2.5 text-sm text-(--color-text-primary) placeholder:text-(--color-text-muted) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-primary)"
            placeholder="Jan Kowalski"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="cf-email" class="text-sm font-medium text-(--color-text-primary)">E-mail *</label>
          <input
            id="cf-email" name="email" type="email" required autocomplete="email"
            class="min-h-[44px] rounded-lg border border-(--color-border) bg-(--color-background) px-4 py-2.5 text-sm text-(--color-text-primary) placeholder:text-(--color-text-muted) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-primary)"
            placeholder="jan@firma.pl"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="cf-phone" class="text-sm font-medium text-(--color-text-primary)">Telefon</label>
          <input
            id="cf-phone" name="phone" type="tel" autocomplete="tel"
            class="min-h-[44px] rounded-lg border border-(--color-border) bg-(--color-background) px-4 py-2.5 text-sm text-(--color-text-primary) placeholder:text-(--color-text-muted) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-primary)"
            placeholder="+48 123 456 789"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="cf-service" class="text-sm font-medium text-(--color-text-primary)">Temat / usługa</label>
          <select
            id="cf-service" name="service"
            class="min-h-[44px] rounded-lg border border-(--color-border) bg-(--color-background) px-4 py-2.5 text-sm text-(--color-text-primary) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-primary)"
          >
            <option value="">Wybierz usługę</option>
            {services.map((service) => (
              <option value={service.slug}>{service.title}</option>
            ))}
            <option value="inne">Inne / nie jestem pewien</option>
          </select>
        </div>

        <div class="flex flex-col gap-2 sm:col-span-2">
          <label for="cf-message" class="text-sm font-medium text-(--color-text-primary)">Wiadomość *</label>
          <textarea
            id="cf-message" name="message" rows="5" required
            class="rounded-lg border border-(--color-border) bg-(--color-background) px-4 py-2.5 text-sm text-(--color-text-primary) placeholder:text-(--color-text-muted) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-primary)"
            placeholder="Opisz krótko, czego potrzebujesz..."
          ></textarea>
        </div>

        <div class="sm:col-span-2">
          <Button type="submit" variant="primary" size="lg" class="w-full sm:w-auto" data-od-id="contact-form-submit">
            Wyślij zapytanie
          </Button>
          <p id="contact-form-status" role="status" class="mt-3 text-sm text-(--color-text-secondary)" aria-live="polite"></p>
        </div>
      </form>
    </div>

    <div class="flex flex-col gap-6">
      <div class="card-surface p-6 md:p-8">
        <h3 class="text-sm font-bold uppercase tracking-wider text-(--color-text-muted)">Dane kontaktowe</h3>
        <ul class="mt-5 space-y-4 text-sm">
          <li class="flex items-start gap-3">
            <Icon name="map-pin" class="mt-0.5 h-5 w-5 flex-shrink-0 text-(--color-primary)" />
            <span class="text-(--color-text-secondary)">{footerColumns.contact.address}</span>
          </li>
          <li class="flex items-center gap-3">
            <Icon name="phone" class="h-5 w-5 flex-shrink-0 text-(--color-primary)" />
            <a href={`tel:${footerColumns.contact.phone.replace(/\s/g, "")}`} class="link-underline text-(--color-text-secondary) hover:text-(--color-primary)">
              {footerColumns.contact.phone}
            </a>
          </li>
          <li class="flex items-center gap-3">
            <Icon name="mail" class="h-5 w-5 flex-shrink-0 text-(--color-primary)" />
            <a href={`mailto:${footerColumns.contact.email}`} class="link-underline text-(--color-text-secondary) hover:text-(--color-primary)">
              {footerColumns.contact.email}
            </a>
          </li>
        </ul>
      </div>

      <div class="card-surface overflow-hidden p-0" data-od-id="contact-map">
        <iframe
          title="Lokalizacja way-IT na mapie"
          src="https://www.google.com/maps?q=Krak%C3%B3w&output=embed"
          class="h-64 w-full grayscale-[15%]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </Container>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-form-status");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (status) status.textContent = "Wysyłanie...";

    try {
      const formData = new FormData(form);
      const response = await fetch("/api/contact", {
        method: "POST",
        body: formData,
      });
      if (!response.ok) throw new Error("request-failed");
      if (status) status.textContent = "Dziękujemy! Odpowiemy w ciągu jednego dnia roboczego.";
      form.reset();
    } catch {
      if (status) status.textContent = "Nie udało się wysłać wiadomości. Spróbuj ponownie lub zadzwoń do nas.";
    }
  });
</script>
