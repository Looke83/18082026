---
// Strong closing call-to-action before the footer. Single primary CTA
// per the action-economy rule — no duplicate solid buttons.
// NOTE: the CTA sits on a solid --color-primary background, so it uses a
// dedicated scoped button (not the shared Button.astro primary/secondary
// variants) to guarantee deterministic hover contrast without fighting
// Tailwind utility specificity.
import Container from "../layout/Container.astro";

export interface Props {
  title?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title = "Porozmawiajmy o Twojej infrastrukturze IT",
  description = "Bezpłatnie przeanalizujemy Twoje potrzeby i przygotujemy konkretną wycenę — bez zobowiązań.",
  ctaLabel = "Bezpłatna wycena",
  ctaHref = "/kontakt",
} = Astro.props;
---

<section class="py-16 md:py-20" data-od-id="cta-section" aria-labelledby="cta-heading">
  <Container>
    <div class="relative overflow-hidden rounded-3xl bg-(--color-primary) px-8 py-14 text-center md:px-16 md:py-20">
      <svg
        class="absolute inset-0 h-full w-full opacity-15"
        viewBox="0 0 800 300"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path d="M0 220 200 140 380 200 560 90 800 160" fill="none" stroke="white" stroke-width="1.5" />
        <circle cx="200" cy="140" r="5" fill="white" />
        <circle cx="560" cy="90" r="5" fill="white" />
        <circle cx="380" cy="200" r="4" fill="white" />
      </svg>
      <div class="relative">
        <h2 id="cta-heading" class="text-3xl font-bold tracking-tight text-(--color-primary-fg) md:text-4xl">
          {title}
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-(--color-primary-fg)/85 md:text-lg">
          {description}
        </p>
        <div class="mt-8">
          <a href={ctaHref} class="cta-on-primary-button" data-od-id="cta-section-button">
            {ctaLabel}
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  /* Scoped, deterministic hover contrast for the CTA button that sits on
     the solid --color-primary background — a dedicated selector avoids
     relying on Tailwind utility cascade order for a color inversion. */
  .cta-on-primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 52px;
    padding: 1rem 2rem;
    font-size: 1.125rem;
    font-weight: 500;
    border-radius: 0.75rem;
    background-color: var(--color-background);
    color: var(--color-primary);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .cta-on-primary-button:hover {
    background-color: var(--color-surface-alt);
    color: var(--color-primary-hover);
    transform: scale(1.02);
  }
  .cta-on-primary-button:focus-visible {
    outline: 2px solid var(--color-background);
    outline-offset: 2px;
  }
</style>
