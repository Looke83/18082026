---
import Container from "../layout/Container.astro";
import Icon from "../ui/Icon.astro";

export interface Props {
  title?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title = "Porozmawiajmy o Twojej infrastrukturze IT",
  description = "Bezpłatnie przeanalizujemy Twoje potrzeby i przygotujemy konkretną wycenę — bez zobowiązań.",
  ctaLabel = "Bezpłatna wycena",
  ctaHref = "/kontakt",
} = Astro.props;
---

<section
  class="py-16 md:py-24"
  data-od-id="cta-section"
  aria-labelledby="cta-heading"
>
  <Container>
    <div
      class="card-surface relative overflow-hidden rounded-3xl border border-(--color-border) p-8 md:p-16 text-center shadow-xl"
    >
      <!-- Subtelny gradient w tle i promień światła (glow effect) -->
      <div
        class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 h-64 w-96 rounded-full bg-(--color-primary)/15 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <!-- Tło z delikatną siatką dot-pattern -->
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.03] dark:opacity-[0.07]"
        style="background-image: radial-gradient(var(--color-text-primary) 1px, transparent 1px); background-size: 16px 16px;"
        aria-hidden="true"
      >
      </div>

      <div class="relative z-10 max-w-2xl mx-auto">
        <h2
          id="cta-heading"
          class="text-3xl font-bold tracking-tight text-(--color-text-primary) md:text-4xl"
        >
          {title}
        </h2>

        <p
          class="mt-4 text-base leading-relaxed text-(--color-text-secondary) md:text-lg"
        >
          {description}
        </p>

        <div class="mt-8 flex justify-center">
          <a
            href={ctaHref}
            class="cta-modern-button group"
            data-od-id="cta-section-button"
          >
            <span>{ctaLabel}</span>
            <Icon
              name="arrow-right"
              class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
            />
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  /* Styl przycisku z płynnym podświetleniem obramowania i delikatnym skalowaniem */
  .cta-modern-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 52px;
    padding: 0.875rem 2rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 0.75rem;
    background-color: var(--color-primary);
    color: var(--color-primary-fg, #ffffff);
    box-shadow: 0 4px 14px 0 rgba(0, 0, 0, 0.1);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-modern-button:hover {
    background-color: var(--color-primary-hover, var(--color-primary));
    transform: translateY(-2px);
    box-shadow: 0 6px 20px 0 rgba(0, 0, 0, 0.15);
  }

  .cta-modern-button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }
</style>
