---
// Grayscale partner/client logo strip. Uses simple lettermark placeholders
// clearly generic (not fabricated brand identities) until real logos exist.
import Container from "../layout/Container.astro";

const marks = [
  "Hikvision",
  "Dahua",
  "BERBREIS",
  "Satel",
  "Ajax",
  "WordPress",
  "Astro",
];
---

<section
  class="py-12 md:py-16"
  data-od-id="logos-strip"
  aria-label="Współpracujemy z najlepszymi markami w branży IT, monitoringu i bezpieczeństwa"
>
  <Container>
    <p
      class="mb-8 text-center text-xs font-semibold uppercase tracking-wider text-(--color-text-muted)"
    >
      Współpracujemy z najlepszymi markami w branży IT, monitoringu i
      bezpieczeństwa
    </p>
    <div
      class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6 opacity-70 grayscale"
    >
      {
        marks.map((mark) => (
          <span class="font-heading text-lg font-bold tracking-tight text-(--color-text-secondary)">
            {mark}
          </span>
        ))
      }
    </div>
  </Container>
</section>
